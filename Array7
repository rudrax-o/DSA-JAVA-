package Arrays;
//To print the product of an array
import java.util.Scanner;
public class Array7 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0 ;i<arr.length;i++){
            arr[i] = sc.nextInt();
        }
        Rudra(arr);
    }
    public static void Rudra(int[] arr){
        int product = 1;
        for(int i = 0 ;i<arr.length;i++){
            product *=arr[i];
        }
        System.out.println(product);
    }
}
