package Arrays;
//To print negative elements only from an array
import java.util.Scanner;
public class Array1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the array size : ");
        int n = sc.nextInt();
        int[] arr = new int[n];
        System.out.print("Enter the elements : ");
        for (int i = 0; i < n; i++) {
            arr[i]=sc.nextInt();
        }
        for(int i=1;i<n;i++){
            if(arr[i]<0){
                System.out.print(arr[i]+" ");
            }
        }
        System.out.println();
    }
}
