package Arrays;
//To print the
public class TwoSum {
    public static void main(String[] args) {
        int[] a = {1,2,3,4,5};
        int target = 2;
        for(int i = 0;i<a.length;i++){
            for(int j = 0;j<a.length;j++){
                if(a[i]+a[j]==target){
                    System.out.println("The number "+a[i]+" and "+a[j]+" When added it gives the target value "+target);
                }
            }
        }
    }
}
