package Arrays;

public class ArrayManually {
    public static void main(String[] args) {
        int[][] arr = {{6,0,7,6},{1,3,2,2},{9,9,5,2}};
        for(int j=0;j<arr[0].length;j++){
            for(int i=0;i<arr.length;i++){
                System.out.print(arr[i][j]+" ");
            }
            System.out.println();
        }

            System.out.println();
        }
}
