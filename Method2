package Methods;
/*Permutation = n!
               ----
               (n-r)!

Combination = n!
            ------
            (r!)*(n-r)!
 */
import java.util.Scanner;
public class PermutationandCombination {
    public static int fact(int x){
        int f=1;
        for(int i=1;i<=x;i++){
            f=f*i;
        }
        return f;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int r = sc.nextInt();
        int ncr = fact(n)/fact(r)*fact(n-r);
        int cpr = fact(n)/fact(n-r);
        System.out.println("Permutation:"+cpr+"  "+"Combination:"+cpr);
    }
}
