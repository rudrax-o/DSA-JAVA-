import java.util.Scanner;
public class Array10 {
    
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        int l = arr.length;
        for(int i = 0;i<l;i++){
            arr[i] = sc.nextInt();
        }
        repeated(arr);
    }
    public static void repeated(int[] arr){
        int l = arr.length;
        for(int i=0;i<l;i++){
            for(int j=i+1;j<l;j++){
                if(arr[i] == arr[j]){
                     System.out.println(arr[i]);
            }
            else System.out.println("-1");
        }
        }
    }
}
