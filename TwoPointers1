import java.util.Scanner;
import java.util.Arrays;
//Program To sort even arrays first and then put odd arrays behind it
public class TwoPointers1{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int [] arr = new int[n];
        for(int i=0;i<arr.length;i++){
            arr[i] = sc.nextInt();
    }
    sort(arr);
}
public static void sort(int[] arr){
    int l = arr.length;
    for(int i=0;i<l;i++){
        for(int j=i+1;j<l;j++){
            if(arr[i]%2==0 && arr[j]%2!=0){
                int temp = arr[j];
                arr[j] = arr[i];
                arr[i] = temp;
            }
        }
        }
        for(int i=0;i<l;i++){
            for(int j=i+1;j<l;j++){
                if(arr[i]%2==0 && arr[j]%2!=0){
                    int temp = arr[j];
                    arr[j] = arr[i];
                    arr[i] = temp;
                }
            }
        }
        System.out.println(Arrays.toString(arr));
    
}
}
