package Arrays;
import java.util.Scanner;
//To print the arr,if multiply odd indexed elements by 2 and add 10 to even indexed elements
public class Array6 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr =new int[n];
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        Rudra(arr);
    }
    public static void Rudra(int[] arr){
        for(int i=0;i<arr.length;i++){
            if(i%2==0){
                System.out.print(arr[i]+10+" ");
            }
            else {
                System.out.print(arr[i]*2+" ");
            }
            System.out.println();
        }

    }
}
